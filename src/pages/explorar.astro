---
// Discovery feed: most-recent public routes across all users, no filters
// (explicit v1 scope). Static page rendered client-side, same pattern as
// perfil.astro and the ?r= share-link loading on the home page.
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="es">
<head>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-EJ82SWLJV0"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-EJ82SWLJV0');
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Explorar · Desnivel</title>
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
  window.__SUPABASE_URL__ = SUPABASE_URL;
  window.__SUPABASE_ANON_KEY__ = SUPABASE_ANON_KEY;
</script>
<style is:global>
:root {
  --bg: #f4f2ee; --s1: #ffffff; --border: #e1ddd2; --border2: #cfc9ba;
  --orange: #e8650a; --orange2: #ff7c2a; --text: #1a1a1a; --muted: #6b6558; --muted2: #9a9384;
  --up2: #c0392b; --mid: #c67c0e; --flat: #2f9e44; --down2: #0d47a1;
}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.5;}
a{text-decoration:none;color:inherit;}
header{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 28px;background:var(--s1);border-bottom:1px solid var(--border);
}
.logo{display:flex;align-items:center;gap:10px;}
.logo-text{font-size:17px;font-weight:800;letter-spacing:-.4px;color:var(--text);}
.logo-text span{color:var(--orange);}
.nav-link{font-size:13px;font-weight:600;color:var(--muted);white-space:nowrap;}
.nav-link.active{color:var(--orange);font-weight:700;}
.header-nav{display:flex;align-items:center;gap:22px;}
.upload-btn{
  display:flex;align-items:center;gap:7px;background:var(--orange);color:#fff;border:none;
  padding:9px 18px;border-radius:8px;font-size:13px;font-weight:700;white-space:nowrap;
}
.upload-btn:hover{background:var(--orange2);}
@media(max-width:480px){
  header{padding:12px 16px;gap:8px;}
  .logo-text{font-size:15px;}
  .header-nav{gap:10px;}
  .nav-link{font-size:12px;}
  .upload-btn .btn-label{display:none;}
  .upload-btn{padding:9px 10px;}
}
main{max-width:1200px;margin:0 auto;padding:40px 24px 80px;}
h1{font-size:26px;font-weight:800;color:var(--text);letter-spacing:-.4px;margin-bottom:6px;}
.subtitle{font-size:14px;color:var(--muted);margin-bottom:28px;}
#state-msg{font-size:14px;color:var(--muted);text-align:center;padding:60px 20px;}
.route-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;}
.route-card{
  background:var(--s1);border:1px solid var(--border);border-radius:14px;padding:18px;
  display:flex;flex-direction:column;gap:10px;
}
.card-owner{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--muted);}
.card-owner-avatar{
  width:22px;height:22px;border-radius:50%;color:#fff;font-size:10.5px;font-weight:700;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.route-card-name{font-size:15px;font-weight:700;color:var(--text);}
.route-card-location{display:flex;align-items:center;gap:4px;font-size:12px;color:var(--muted);margin-top:-4px;}
.route-card-stats{display:flex;gap:14px;font-size:12.5px;color:var(--muted);}
.route-card-stats b{color:var(--text);}
.diff-pill{font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:20px;width:fit-content;}
.route-card-link{margin-top:4px;font-size:12.5px;font-weight:700;color:var(--orange);display:flex;align-items:center;gap:6px;}
</style>
</head>
<body>

<header>
  <a class="logo" href="/">
    <svg width="32" height="32" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
      <rect width="512" height="512" rx="112" fill="#141414"/>
      <path d="M30 420 L170 185 L230 260 L256 220 L282 260 L342 185 L482 420Z" fill="#1c1c1c"/>
      <path d="M52 390 C80 388,108 384,130 362 C152 340,162 308,178 280 C194 252,212 230,228 208 C240 190,250 172,256 152 C262 172,268 190,280 208 C296 230,316 256,336 288 C356 320,374 350,400 370 C424 386,446 390,462 392" fill="none" stroke="#e8650a" stroke-width="36" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="logo-text">Desni<span>vel</span></span>
  </a>
  <nav class="header-nav">
    <a class="nav-link active" href="/explorar">Explorar</a>
    <a class="nav-link" href="/">Analizador</a>
    <a class="nav-link" id="nav-my-profile" href="/" style="display:none">Mi perfil</a>
    <a class="upload-btn" href="/">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      <span class="btn-label">Subir GPX</span>
    </a>
  </nav>
</header>

<main>
  <h1>Explorar rutas</h1>
  <p class="subtitle">Lo último que subió la comunidad — entra a cada una para ver el mapa y descargar el GPX.</p>
  <div id="state-msg">Cargando rutas…</div>
  <div class="route-grid" id="route-grid"></div>
</main>

<script is:inline>
const supabaseClient = supabase.createClient(window.__SUPABASE_URL__, window.__SUPABASE_ANON_KEY__);

const DIFF_COLORS = {
  'Fácil':    { bg: '#e8f5e9', fg: 'var(--flat)' },
  'Moderada': { bg: '#fdf3e3', fg: 'var(--mid)' },
  'Difícil':  { bg: '#fdeee9', fg: '#d9480f' },
  'Extrema':  { bg: '#fbeae8', fg: 'var(--up2)' },
};

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function routeCardHtml(row, profile){
  const plan = row.plan || {};
  const summary = plan.summary || {};
  const name = plan.name || plan.filename || 'Ruta sin nombre';
  const diff = summary.diffLabel || '';
  const colors = DIFF_COLORS[diff] || { bg: '#f1f0ec', fg: 'var(--muted)' };
  const owner = profile
    ? `<a class="card-owner" href="/${encodeURIComponent(profile.username)}">
         <div class="card-owner-avatar" style="background:${profile.avatar_color}">${escapeHtml((profile.display_name[0] || profile.username[0] || '?').toUpperCase())}</div>
         @${escapeHtml(profile.username)}
       </a>`
    : `<div class="card-owner">Compartido anónimamente</div>`;
  return `
    <div class="route-card">
      ${owner}
      <div class="route-card-name">${escapeHtml(name)}</div>
      ${row.location ? `
      <div class="route-card-location">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        ${escapeHtml(row.location)}
      </div>` : ''}
      <div class="route-card-stats">
        <span><b>${escapeHtml(summary.dist || '—')}</b></span>
        <span>↑ <b>${escapeHtml(summary.gain || '—')}</b></span>
      </div>
      ${diff ? `<span class="diff-pill" style="background:${colors.bg};color:${colors.fg}">${escapeHtml(diff)}</span>` : ''}
      <a class="route-card-link" href="/r/${encodeURIComponent(row.id)}">Ver ruta →</a>
    </div>
  `;
}

async function loadFeed(){
  const stateMsg = document.getElementById('state-msg');
  const grid = document.getElementById('route-grid');

  const { data: { session } } = await supabaseClient.auth.getSession();
  if (session) {
    const { data: myProfile } = await supabaseClient.from('profiles').select('username').eq('id', session.user.id).maybeSingle();
    if (myProfile) {
      const link = document.getElementById('nav-my-profile');
      link.href = '/' + myProfile.username;
      link.style.display = '';
    }
  }

  const { data: routes, error } = await supabaseClient
    .from('routes')
    .select('id, user_id, plan, location, created_at')
    .eq('is_hidden', false)
    .order('created_at', { ascending: false })
    .limit(30);

  if (error) {
    stateMsg.textContent = 'No se pudieron cargar las rutas.';
    return;
  }
  if (!routes.length) {
    stateMsg.textContent = 'Todavía no hay rutas compartidas por la comunidad.';
    return;
  }

  const userIds = [...new Set(routes.filter(r => r.user_id).map(r => r.user_id))];
  let profileById = {};
  if (userIds.length) {
    const { data: profiles } = await supabaseClient
      .from('profiles')
      .select('id, username, display_name, avatar_color')
      .in('id', userIds);
    profileById = Object.fromEntries((profiles || []).map(p => [p.id, p]));
  }

  grid.innerHTML = routes.map(r => routeCardHtml(r, profileById[r.user_id])).join('');
  stateMsg.style.display = 'none';
}

loadFeed();
</script>
</body>
</html>
