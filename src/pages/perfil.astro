---
// Public profile page. Reached as a clean /<username> URL via the Netlify
// rewrite in netlify.toml (/:username -> /perfil, status 200). A rewrite to
// a STATIC file only affects which file's bytes get served — the browser's
// own address bar (and location.pathname/search) always stays exactly what
// it actually requested, i.e. "/<username>" with no query string. So the
// username has to be read from location.pathname, not a ?u= query param
// (which a rewrite target can never actually deliver to client-side JS for
// a static response). ?u= is kept as a fallback for local dev, where there's
// no Netlify rewrite and this page is hit directly as /perfil?u=<username>.
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="es">
<head>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-EJ82SWLJV0"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-EJ82SWLJV0');
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Perfil · Desnivel</title>
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
  window.__SUPABASE_URL__ = SUPABASE_URL;
  window.__SUPABASE_ANON_KEY__ = SUPABASE_ANON_KEY;
</script>
<style is:global>
:root {
  --bg: #f4f2ee; --s1: #ffffff; --border: #e1ddd2; --border2: #cfc9ba;
  --orange: #e8650a; --orange2: #ff7c2a; --text: #1a1a1a; --muted: #6b6558; --muted2: #9a9384;
  --up2: #c0392b; --mid: #c67c0e; --flat: #2f9e44; --down2: #0d47a1;
}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.5;}
a{text-decoration:none;color:inherit;}
header{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 28px;background:var(--s1);border-bottom:1px solid var(--border);
}
.logo{display:flex;align-items:center;gap:10px;}
.logo-text{font-size:17px;font-weight:800;letter-spacing:-.4px;color:var(--text);}
.logo-text span{color:var(--orange);}
.nav-link{font-size:13px;font-weight:600;color:var(--muted);white-space:nowrap;}
.header-nav{display:flex;align-items:center;gap:22px;}
@media(max-width:480px){
  header{padding:12px 16px;gap:8px;}
  .logo-text{font-size:15px;}
  .header-nav{gap:12px;}
  .nav-link{font-size:12px;}
  .profile-header{flex-wrap:wrap;}
  .edit-profile-btn{margin-left:0;}
}
main{max-width:1000px;margin:0 auto;padding:48px 24px 80px;}
#state-msg{font-size:14px;color:var(--muted);text-align:center;padding:60px 20px;}
.profile-header{display:flex;align-items:center;gap:20px;margin-bottom:8px;}
.edit-profile-btn{
  margin-left:auto;background:var(--s1);border:1px solid var(--border2);color:var(--text);
  font-size:13px;font-weight:600;padding:9px 18px;border-radius:8px;
}
.edit-profile-btn:hover{border-color:var(--orange);color:var(--orange);}
.card-icon-btn{
  width:26px;height:26px;border-radius:7px;background:var(--bg);border:1px solid var(--border2);
  display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--muted);
}
.card-icon-btn:hover{border-color:var(--muted2);color:var(--text);}
.card-icon-btn.danger:hover{border-color:var(--up2);color:var(--up2);}
.card-owner-actions{display:flex;gap:6px;margin-left:auto;}
.hidden-badge{
  font-size:10px;font-weight:700;letter-spacing:.3px;color:var(--muted);background:var(--bg);
  padding:3px 8px;border-radius:20px;width:fit-content;
}
.route-card.is-hidden{opacity:.55;}
.profile-avatar{
  width:76px;height:76px;border-radius:50%;color:#fff;font-size:30px;font-weight:800;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.profile-name{font-size:22px;font-weight:800;color:var(--text);}
.profile-meta{font-size:14px;color:var(--muted);margin-top:2px;}
.divider{height:1px;background:var(--border);margin:28px 0 24px;}
.section-title{font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin-bottom:18px;}
.route-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;}
.route-card{
  background:var(--s1);border:1px solid var(--border);border-radius:14px;padding:18px;
  display:flex;flex-direction:column;gap:10px;
}
.route-card-name{font-size:15px;font-weight:700;color:var(--text);}
.route-card-location{display:flex;align-items:center;gap:4px;font-size:12px;color:var(--muted);margin-top:-4px;}
.route-card-stats{display:flex;gap:14px;font-size:12.5px;color:var(--muted);}
.route-card-stats b{color:var(--text);}
.diff-pill{font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:20px;width:fit-content;}
.route-card-link{
  margin-top:4px;font-size:12.5px;font-weight:700;color:var(--orange);display:flex;align-items:center;gap:6px;
}
</style>
</head>
<body>

<header>
  <a class="logo" href="/">
    <svg width="32" height="32" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
      <rect width="512" height="512" rx="112" fill="#141414"/>
      <path d="M30 420 L170 185 L230 260 L256 220 L282 260 L342 185 L482 420Z" fill="#1c1c1c"/>
      <path d="M52 390 C80 388,108 384,130 362 C152 340,162 308,178 280 C194 252,212 230,228 208 C240 190,250 172,256 152 C262 172,268 190,280 208 C296 230,316 256,336 288 C356 320,374 350,400 370 C424 386,446 390,462 392" fill="none" stroke="#e8650a" stroke-width="36" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="logo-text">Desni<span>vel</span></span>
  </a>
  <nav class="header-nav">
    <a class="nav-link" href="/explorar">Explorar</a>
    <a class="nav-link" href="/">Analizador</a>
  </nav>
</header>

<main>
  <div id="state-msg">Cargando perfil…</div>
  <div id="profile-content" style="display:none">
    <div class="profile-header">
      <div class="profile-avatar" id="p-avatar">?</div>
      <div>
        <div class="profile-name" id="p-name"></div>
        <div class="profile-meta" id="p-meta"></div>
      </div>
      <a class="edit-profile-btn" id="edit-profile-link" href="/editar-perfil" style="display:none">Editar perfil</a>
    </div>
    <div class="divider"></div>
    <div class="section-title">Rutas</div>
    <div class="route-grid" id="route-grid"></div>
  </div>
</main>

<script is:inline>
const supabaseClient = supabase.createClient(window.__SUPABASE_URL__, window.__SUPABASE_ANON_KEY__);

const DIFF_COLORS = {
  'Fácil':    { bg: '#e8f5e9', fg: 'var(--flat)' },
  'Moderada': { bg: '#fdf3e3', fg: 'var(--mid)' },
  'Difícil':  { bg: '#fdeee9', fg: '#d9480f' },
  'Extrema':  { bg: '#fbeae8', fg: 'var(--up2)' },
};

function routeCardHtml(row, isOwner){
  const plan = row.plan || {};
  const summary = plan.summary || {};
  const name = plan.name || plan.filename || 'Ruta sin nombre';
  const diff = summary.diffLabel || '';
  const colors = DIFF_COLORS[diff] || { bg: '#f1f0ec', fg: 'var(--muted)' };
  const ownerActions = isOwner ? `
    <div class="card-owner-actions">
      <button type="button" class="card-icon-btn" title="${row.is_hidden ? 'Mostrar' : 'Ocultar'}" onclick="toggleHidden('${row.id}', ${!row.is_hidden})">
        ${row.is_hidden
          ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>'
          : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
        }
      </button>
      <button type="button" class="card-icon-btn danger" title="Borrar" onclick="deleteRoute('${row.id}')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m5 0V4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2"/></svg>
      </button>
    </div>
  ` : '';
  return `
    <div class="route-card ${row.is_hidden ? 'is-hidden' : ''}">
      <div style="display:flex;align-items:flex-start">
        ${row.is_hidden ? '<span class="hidden-badge">OCULTA</span>' : ''}
        ${ownerActions}
      </div>
      <div class="route-card-name">${escapeHtml(name)}</div>
      ${row.location ? `
      <div class="route-card-location">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        ${escapeHtml(row.location)}
      </div>` : ''}
      <div class="route-card-stats">
        <span><b>${escapeHtml(summary.dist || '—')}</b></span>
        <span>↑ <b>${escapeHtml(summary.gain || '—')}</b></span>
      </div>
      ${diff ? `<span class="diff-pill" style="background:${colors.bg};color:${colors.fg}">${escapeHtml(diff)}</span>` : ''}
      <a class="route-card-link" href="/?r=${encodeURIComponent(row.id)}">
        Ver ruta →
      </a>
    </div>
  `;
}

async function toggleHidden(routeId, nextHidden){
  const { error } = await supabaseClient.from('routes').update({ is_hidden: nextHidden }).eq('id', routeId);
  if (error) { alert('No se pudo actualizar la ruta: ' + error.message); return; }
  await loadProfile();
}

async function deleteRoute(routeId){
  if (!confirm('¿Borrar esta ruta? Esta acción no se puede deshacer.')) return;
  const { error } = await supabaseClient.from('routes').delete().eq('id', routeId);
  if (error) { alert('No se pudo borrar la ruta: ' + error.message); return; }
  await loadProfile();
}

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

// See the note at the top of the file: a rewrite never changes what the
// browser's own URL looks like, so the username lives in the path, not a
// query string, once this page is reached the real way (via /<username>).
function usernameFromUrl(){
  const path = location.pathname.replace(/\/+$/, '');
  if (path && path !== '/perfil') return decodeURIComponent(path.replace(/^\/+/, ''));
  return new URLSearchParams(location.search).get('u');
}

async function loadProfile(){
  const username = usernameFromUrl();
  const stateMsg = document.getElementById('state-msg');
  if (!username) { stateMsg.textContent = 'Perfil no encontrado.'; return; }

  const { data: profile, error } = await supabaseClient
    .from('profiles')
    .select('id, username, display_name, avatar_color, created_at')
    .eq('username', username.toLowerCase())
    .maybeSingle();

  if (error || !profile) {
    stateMsg.textContent = `No encontramos a @${username}.`;
    return;
  }

  document.title = `@${profile.username} · Desnivel`;
  document.getElementById('p-avatar').textContent = (profile.display_name[0] || profile.username[0] || '?').toUpperCase();
  document.getElementById('p-avatar').style.background = profile.avatar_color;
  document.getElementById('p-name').textContent = profile.display_name || ('@' + profile.username);
  const year = new Date(profile.created_at).getFullYear();

  const { data: { session } } = await supabaseClient.auth.getSession();
  const isOwner = !!session && session.user.id === profile.id;
  if (isOwner) document.getElementById('edit-profile-link').style.display = '';

  // An owner sees their hidden routes too (RLS allows it); a visitor only
  // sees what's public.
  let query = supabaseClient.from('routes').select('id, plan, is_hidden, location, created_at').eq('user_id', profile.id);
  if (!isOwner) query = query.eq('is_hidden', false);
  const { data: routes } = await query.order('created_at', { ascending: false });

  const routeList = routes || [];
  const visibleCount = routeList.filter(r => !r.is_hidden).length;
  document.getElementById('p-meta').textContent = `@${profile.username} · ${visibleCount} ${visibleCount === 1 ? 'ruta' : 'rutas'} · miembro desde ${year}`;
  document.getElementById('route-grid').innerHTML = routeList.length
    ? routeList.map(r => routeCardHtml(r, isOwner)).join('')
    : '<div style="color:var(--muted);font-size:13.5px">Todavía no ha subido ninguna ruta.</div>';

  stateMsg.style.display = 'none';
  document.getElementById('profile-content').style.display = 'block';
}

loadProfile();
</script>
</body>
</html>
