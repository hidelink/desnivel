---
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Editar perfil · Desnivel</title>
<meta name="description" content="Personaliza tu perfil en Desnivel.">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="canonical" href="https://desnivel.run/editar-perfil">
<meta name="robots" content="noindex">

<meta property="og:type" content="website">
<meta property="og:title" content="Editar perfil · Desnivel">
<meta property="og:description" content="Personaliza tu perfil en Desnivel.">
<meta property="og:image" content="https://desnivel.run/og-image.png">
<meta property="og:locale" content="es_MX">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Editar perfil · Desnivel">
<meta name="twitter:description" content="Personaliza tu perfil en Desnivel.">
<meta name="twitter:image" content="https://desnivel.run/og-image.png">

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
  window.__SUPABASE_URL__ = SUPABASE_URL;
  window.__SUPABASE_ANON_KEY__ = SUPABASE_ANON_KEY;
</script>
<style is:global>
:root {
  --bg: #f4f2ee; --s1: #ffffff; --border: #e1ddd2; --border2: #cfc9ba;
  --orange: #e8650a; --orange2: #ff7c2a; --text: #1a1a1a; --muted: #6b6558; --muted2: #9a9384;
  --up2: #c0392b; --flat: #2f9e44;
}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.5;}
a{text-decoration:none;color:inherit;}
header{display:flex;align-items:center;justify-content:space-between;padding:14px 28px;background:var(--s1);border-bottom:1px solid var(--border);}
.logo{display:flex;align-items:center;gap:10px;}
.logo-text{font-size:17px;font-weight:800;letter-spacing:-.4px;color:var(--text);}
.logo-text span{color:var(--orange);}
.nav-link{display:flex;align-items:center;gap:5px;font-size:13px;font-weight:600;color:var(--muted);white-space:nowrap;}
.nav-link svg{flex-shrink:0;}
.header-nav{display:flex;align-items:center;gap:18px;}
.mini-footer{text-align:center;padding:28px 24px 36px;}
.mini-footer a{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;color:var(--muted2);}
.mini-footer a:hover{color:var(--orange);}
.upload-btn{
  display:flex;align-items:center;gap:7px;background:var(--orange);color:#fff;border:none;
  padding:9px 18px;border-radius:8px;font-size:13px;font-weight:700;white-space:nowrap;
}
.upload-btn:hover{background:var(--orange2);}
.login-btn{
  background:#fff;border:1px solid var(--border2);color:var(--text);
  font-size:13px;font-weight:600;padding:8px 16px;border-radius:8px;cursor:pointer;
}
.login-btn:hover{border-color:var(--orange);color:var(--orange);}
.auth-chip{display:flex;align-items:center;gap:8px;padding:5px 12px 5px 5px;border-radius:20px;border:1px solid var(--border2);}
.auth-avatar{
  width:26px;height:26px;border-radius:50%;background:var(--orange);color:#fff;
  font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
#auth-email{font-size:12.5px;font-weight:600;color:var(--text);max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.logout-btn{
  background:none;border:1px solid var(--border2);color:var(--muted);
  font-size:12.5px;font-weight:600;padding:8px 14px;border-radius:8px;cursor:pointer;
}
.logout-btn:hover{border-color:var(--up2);color:var(--up2);}
@media(max-width:640px){
  header{padding:12px 16px;gap:8px;}
  .logo-text{font-size:15px;}
  .header-nav{gap:6px;}
  .nav-link{font-size:12px;}
  .nav-link .btn-label{display:none;}
  .upload-btn .btn-label{display:none;}
  .upload-btn{padding:9px 10px;}
  .login-btn{padding:8px 10px;font-size:12px;white-space:nowrap;}
  .auth-chip{padding:4px 8px 4px 4px;}
  #auth-email{max-width:60px;}
  .logout-btn{padding:8px 10px;font-size:11.5px;}
}
main{max-width:460px;margin:0 auto;padding:48px 24px 80px;}
#state-msg{font-size:14px;color:var(--muted);text-align:center;padding:60px 20px;}
h1{font-size:20px;font-weight:800;margin-bottom:22px;}
.card{background:var(--s1);border:1px solid var(--border);border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:20px;}
.field{display:flex;flex-direction:column;gap:4px;}
.field label{font-size:12px;font-weight:600;color:var(--muted);}
.field input{width:100%;background:var(--bg);border:1px solid var(--border2);border-radius:8px;padding:10px 11px;font-size:13px;color:var(--text);}
.username-row{display:flex;align-items:center;background:var(--bg);border:1px solid var(--border2);border-radius:8px;padding:0 11px;}
.username-row span{font-size:13px;color:var(--muted2);font-weight:600;}
.username-row input{flex-grow:1;background:transparent;border:none;padding:10px 4px;font-size:13px;color:var(--text);min-width:0;}
.swatches{display:flex;gap:6px;}
.swatch{width:22px;height:22px;border-radius:50%;cursor:pointer;border:2px solid transparent;}
.swatch.selected{border-color:var(--text);}
.avatar-preview{width:48px;height:48px;border-radius:50%;color:#fff;font-size:18px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.avatar-wrap{position:relative;flex-shrink:0;}
.avatar-edit-btn{
  position:absolute;bottom:-2px;right:-2px;width:22px;height:22px;border-radius:50%;
  background:var(--s1);border:1px solid var(--border2);color:var(--muted);
  display:flex;align-items:center;justify-content:center;cursor:pointer;
}
.avatar-edit-btn:hover{border-color:var(--orange);color:var(--orange);}
.remove-photo-btn{
  background:none;border:none;color:var(--muted);font-size:12px;font-weight:600;
  cursor:pointer;text-decoration:underline;text-align:left;padding:0;width:fit-content;
}
.remove-photo-btn:hover{color:var(--up2);}
.actions{display:flex;gap:10px;}
.actions a, .actions button{flex:1;padding:11px;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;border:none;text-align:center;}
.primary{background:var(--orange);color:#fff;}
.primary:hover{background:var(--orange2);}
.secondary{background:#fff;border:1px solid var(--border2);color:var(--text);}

.section-title{font-size:14px;font-weight:800;}
.section-sub{font-size:12px;color:var(--muted);margin-top:2px;}
.pace-row{display:flex;align-items:center;gap:6px;}
.pace-row input{width:56px;text-align:center;background:var(--bg);border:1px solid var(--border2);border-radius:8px;padding:10px 4px;font-size:14px;color:var(--text);}
.pace-row span{font-size:14px;color:var(--muted2);font-weight:700;}
.pace-row .pace-unit{font-size:12px;color:var(--muted);font-weight:600;margin-left:4px;}
.rating-pills{display:flex;gap:6px;}
.rating-pill{flex:1;text-align:center;padding:9px 6px;border:1px solid var(--border2);border-radius:8px;font-size:11.5px;font-weight:600;color:var(--muted);cursor:pointer;background:var(--bg);}
.rating-pill.selected{border-color:var(--orange);color:var(--orange);background:rgba(232,101,10,.08);}

/* ── TOAST (replaces native alert) ─────────────────────────
   Dark regardless of page theme, same convention as other floating
   chip UI — avoids looking like a browser dialog. */
#toast-container{
  position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:3500;
  display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none;
  width:100%;padding:0 20px;
}
.toast{
  background:#1e1e1e;color:#f1f1f1;font-size:13px;font-weight:600;line-height:1.4;
  padding:12px 18px;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.3);
  opacity:0;transform:translateY(10px);transition:opacity .25s,transform .25s;
  max-width:380px;text-align:center;pointer-events:auto;border-left:4px solid var(--up2);
}
.toast.show{opacity:1;transform:translateY(0);}
</style>
</head>
<body>

<div id="toast-container"></div>

<header>
  <a class="logo" href="/">
    <svg width="36" height="36" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0">
      <rect width="512" height="512" rx="112" fill="#141414"/>
      <path d="M30 420 L170 185 L230 260 L256 220 L282 260 L342 185 L482 420Z" fill="#1c1c1c"/>
      <path d="M52 390 C80 388,108 384,130 362 C152 340,162 308,178 280 C194 252,212 230,228 208 C240 190,250 172,256 152 C262 172,268 190,280 208 C296 230,316 256,336 288 C356 320,374 350,400 370 C424 386,446 390,462 392" fill="none" stroke="#e8650a" stroke-width="36" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="52"  cy="390" r="28" fill="#141414" stroke="#4fc3f7" stroke-width="16"/>
      <circle cx="256" cy="152" r="28" fill="#141414" stroke="#e8650a" stroke-width="16"/>
      <circle cx="256" cy="152" r="10" fill="#ff8c3a"/>
    </svg>
    <span class="logo-text">Desni<span>vel</span></span>
  </a>
  <nav class="header-nav">
    <a class="nav-link" href="/">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="3 12 8 12 10 18 14 6 16 12 21 12"/></svg>
      <span class="btn-label">Analizador</span>
    </a>
    <a class="upload-btn" href="/">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      <span class="btn-label">Subir GPX</span>
    </a>
    <div id="auth-logged-out" style="display:flex;align-items:center">
      <a class="login-btn" href="/">Iniciar sesión</a>
    </div>
    <div id="auth-logged-in" style="display:none;align-items:center;gap:10px">
      <a class="auth-chip" id="auth-chip-link" href="/">
        <div class="auth-avatar" id="auth-avatar">?</div>
        <span id="auth-email"></span>
      </a>
      <button class="logout-btn" onclick="headerLogout()">Salir</button>
    </div>
  </nav>
</header>

<main>
  <div id="state-msg">Cargando…</div>
  <div id="form-content" style="display:none">
    <h1>Editar perfil</h1>
    <div class="card">
      <div style="display:flex;align-items:center;gap:14px">
        <div class="avatar-wrap">
          <div class="avatar-preview" id="ep-avatar-preview">?</div>
          <button type="button" class="avatar-edit-btn" onclick="document.getElementById('ep-photo-input').click()" title="Cambiar foto">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          </button>
          <input type="file" id="ep-photo-input" accept="image/jpeg,image/png,image/webp" style="display:none">
        </div>
        <div style="display:flex;flex-direction:column;gap:10px">
          <div class="swatches" id="ep-color-swatches">
            <div class="swatch" data-color="#e8650a" style="background:#e8650a"></div>
            <div class="swatch" data-color="#0d47a1" style="background:#0d47a1"></div>
            <div class="swatch" data-color="#2f9e44" style="background:#2f9e44"></div>
            <div class="swatch" data-color="#8e44ad" style="background:#8e44ad"></div>
            <div class="swatch" data-color="#c0392b" style="background:#c0392b"></div>
          </div>
          <button type="button" class="remove-photo-btn" id="ep-remove-photo-btn" style="display:none" onclick="removeAvatarPhoto()">Quitar foto</button>
        </div>
      </div>
      <div class="field">
        <label for="ep-name">Nombre</label>
        <input id="ep-name" type="text">
      </div>
      <div class="field">
        <label for="ep-username">Usuario</label>
        <div class="username-row">
          <span>desnivel.run/</span>
          <input id="ep-username" type="text">
        </div>
        <div id="ep-username-status" style="font-size:11.5px;margin-top:2px;min-height:16px"></div>
      </div>
      <div class="actions">
        <a class="secondary" id="cancel-link" href="/">Cancelar</a>
        <button type="button" class="primary" onclick="saveProfile()">Guardar cambios</button>
      </div>
    </div>

    <div class="card" style="margin-top:16px">
      <div>
        <div class="section-title">Ritmo personalizado</div>
        <div class="section-sub">Opcional — ajusta el "Tiempo estimado" y la calculadora de carrera a tu ritmo real, en vez de un promedio genérico.</div>
      </div>
      <div class="field">
        <label>Ritmo en plano</label>
        <div class="pace-row">
          <input id="ep-pace-min" type="number" min="3" max="15" placeholder="6">
          <span>:</span>
          <input id="ep-pace-sec" type="number" min="0" max="59" placeholder="00">
          <span class="pace-unit">min/km</span>
        </div>
      </div>
      <div class="field">
        <label>Subidas</label>
        <div class="rating-pills" id="ep-uphill-pills" data-field="uphill">
          <div class="rating-pill" data-value="dificil">Se me dificulta</div>
          <div class="rating-pill" data-value="normal">Normal</div>
          <div class="rating-pill" data-value="bueno">Se me da bien</div>
        </div>
      </div>
      <div class="field">
        <label>Bajadas</label>
        <div class="rating-pills" id="ep-downhill-pills" data-field="downhill">
          <div class="rating-pill" data-value="dificil">Se me dificulta</div>
          <div class="rating-pill" data-value="normal">Normal</div>
          <div class="rating-pill" data-value="bueno">Se me da bien</div>
        </div>
      </div>
    </div>
  </div>
</main>

<footer class="mini-footer">
  <a href="https://instagram.com/hidelink" target="_blank" rel="noopener">
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
    @hidelink
  </a>
</footer>


<script is:inline>
const supabaseClient = supabase.createClient(window.__SUPABASE_URL__, window.__SUPABASE_ANON_KEY__);

// Header auth state — same chip/login-button pattern as the home page.
async function renderHeaderAuth(session){
  const loggedOut = document.getElementById('auth-logged-out');
  const loggedIn = document.getElementById('auth-logged-in');
  if (!session) { loggedOut.style.display = 'flex'; loggedIn.style.display = 'none'; return; }
  loggedOut.style.display = 'none'; loggedIn.style.display = 'flex';
  const email = session.user.email || '';
  document.getElementById('auth-avatar').textContent = (email[0] || '?').toUpperCase();
  document.getElementById('auth-email').textContent = email;
  const { data: profile } = await supabaseClient.from('profiles').select('username, avatar_color').eq('id', session.user.id).maybeSingle();
  if (profile) {
    document.getElementById('auth-avatar').style.background = profile.avatar_color;
    document.getElementById('auth-email').textContent = '@' + profile.username;
    document.getElementById('auth-chip-link').href = '/' + profile.username;
  }
}
async function headerLogout(){
  await supabaseClient.auth.signOut();
  location.href = '/';
}
supabaseClient.auth.onAuthStateChange((_event, session) => renderHeaderAuth(session));
supabaseClient.auth.getSession().then(({ data }) => renderHeaderAuth(data.session));

function showToast(message){
  const container = document.getElementById('toast-container');
  const el = document.createElement('div');
  el.className = 'toast';
  el.textContent = message;
  container.appendChild(el);
  requestAnimationFrame(() => el.classList.add('show'));
  setTimeout(() => {
    el.classList.remove('show');
    setTimeout(() => el.remove(), 300);
  }, 4200);
}
let epSelectedColor = '#e8650a';
let epUserId = null;
let epUsernameCheckTimer = null;

let epAvatarUrl = null;
let epUphillRating = null;
let epDownhillRating = null;

function setRating(field, value){
  if (field === 'uphill') epUphillRating = value; else epDownhillRating = value;
  const container = document.getElementById(field === 'uphill' ? 'ep-uphill-pills' : 'ep-downhill-pills');
  container.querySelectorAll('.rating-pill').forEach(el => el.classList.toggle('selected', el.dataset.value === value));
}

function setColor(color){
  epSelectedColor = color;
  document.querySelectorAll('.swatch').forEach(el => el.classList.toggle('selected', el.dataset.color === color));
  updateAvatarPreviewUI();
}

// A photo takes priority over the color+initial circle wherever an avatar
// renders — the swatches only matter again once there's no photo, so they
// hide instead of sitting there looking like they do nothing.
function updateAvatarPreviewUI(){
  const el = document.getElementById('ep-avatar-preview');
  const swatches = document.getElementById('ep-color-swatches');
  const removeBtn = document.getElementById('ep-remove-photo-btn');
  if (epAvatarUrl) {
    el.style.background = `center/cover no-repeat url('${epAvatarUrl}')`;
    el.textContent = '';
    swatches.style.display = 'none';
    removeBtn.style.display = 'block';
  } else {
    el.style.background = epSelectedColor;
    const name = document.getElementById('ep-name').value.trim();
    const username = document.getElementById('ep-username').value.trim();
    el.textContent = (name[0] || username[0] || '?').toUpperCase();
    swatches.style.display = 'flex';
    removeBtn.style.display = 'none';
  }
}

function removeAvatarPhoto(){
  epAvatarUrl = null;
  updateAvatarPreviewUI();
}

// Downscale + center-crop to a square before upload — a phone photo
// straight out of the camera can be 5-10MB and isn't square, neither of
// which anything here needs.
function resizeImageToSquare(file, size){
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = size; canvas.height = size;
        const ctx = canvas.getContext('2d');
        const minSide = Math.min(img.width, img.height);
        const sx = (img.width - minSide) / 2;
        const sy = (img.height - minSide) / 2;
        ctx.drawImage(img, sx, sy, minSide, minSide, 0, 0, size, size);
        canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('No se pudo procesar la imagen.')), 'image/jpeg', 0.85);
      };
      img.onerror = () => reject(new Error('No se pudo leer la imagen.'));
      img.src = e.target.result;
    };
    reader.onerror = () => reject(new Error('No se pudo leer el archivo.'));
    reader.readAsDataURL(file);
  });
}

async function handleAvatarPhotoSelect(file){
  if (!file) return;
  if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
    showToast('Usa una imagen JPG, PNG o WEBP.');
    return;
  }
  if (file.size > 8 * 1024 * 1024) {
    showToast('La imagen es muy pesada (máx 8MB).');
    return;
  }
  try {
    const blob = await resizeImageToSquare(file, 320);
    const path = `${epUserId}/avatar.jpg`;
    const { error: uploadError } = await supabaseClient.storage
      .from('avatars')
      .upload(path, blob, { contentType: 'image/jpeg', upsert: true });
    if (uploadError) throw uploadError;
    const { data: urlData } = supabaseClient.storage.from('avatars').getPublicUrl(path);
    // Same path every time (upsert) — a fresh timestamp is what actually
    // busts other viewers' cached copy of the old photo.
    epAvatarUrl = urlData.publicUrl + '?t=' + Date.now();
    updateAvatarPreviewUI();
  } catch (err) {
    showToast('No se pudo subir la foto: ' + err.message);
  }
}

function normalizeUsername(raw){
  return raw.trim().toLowerCase().replace(/[^a-z0-9_]/g, '');
}

// Real top-level routes a username would otherwise shadow — see the same
// list and reasoning in index.astro's onboarding step.
const RESERVED_USERNAMES = new Set([
  'perfil', 'editar-perfil', 'explorar', 'rutas', 'acerca', 'en', 'api',
  'admin', 'login', 'signup', 'logout', 'index', 'r',
]);

async function checkUsernameAvailability(){
  const status = document.getElementById('ep-username-status');
  const username = normalizeUsername(document.getElementById('ep-username').value);
  if (!username) { status.textContent = ''; return; }
  if (!/^[a-z0-9_]{3,20}$/.test(username)) {
    status.textContent = 'Usa minúsculas, números y guion bajo. 3–20 caracteres.';
    status.style.color = 'var(--up2)';
    return;
  }
  if (RESERVED_USERNAMES.has(username)) {
    status.textContent = 'Ese usuario está reservado.';
    status.style.color = 'var(--up2)';
    return;
  }
  status.textContent = 'Revisando…';
  status.style.color = 'var(--muted2)';
  const { count } = await supabaseClient
    .from('profiles')
    .select('username', { count: 'exact', head: true })
    .eq('username', username)
    .neq('id', epUserId);
  if (count > 0) {
    status.textContent = 'Ese usuario ya está en uso.';
    status.style.color = 'var(--up2)';
  } else {
    status.textContent = '✓ Disponible';
    status.style.color = 'var(--flat)';
  }
}

async function saveProfile(){
  const username = normalizeUsername(document.getElementById('ep-username').value);
  const displayName = document.getElementById('ep-name').value.trim() || username;
  if (!/^[a-z0-9_]{3,20}$/.test(username)) {
    showToast('Usuario inválido: usa minúsculas, números y guion bajo, 3–20 caracteres.');
    return;
  }
  if (RESERVED_USERNAMES.has(username)) {
    showToast('Ese usuario está reservado. Elige otro.');
    return;
  }

  const minRaw = document.getElementById('ep-pace-min').value.trim();
  const secRaw = document.getElementById('ep-pace-sec').value.trim();
  let paceFlatSec = null;
  if (minRaw || secRaw) {
    paceFlatSec = (parseInt(minRaw, 10) || 0) * 60 + (parseInt(secRaw, 10) || 0);
    if (paceFlatSec < 180 || paceFlatSec > 900) {
      showToast('El ritmo en plano debe estar entre 3:00 y 15:00 min/km.');
      return;
    }
  }

  const { error } = await supabaseClient
    .from('profiles')
    .update({
      username, display_name: displayName, avatar_color: epSelectedColor, avatar_url: epAvatarUrl,
      pace_flat_sec_per_km: paceFlatSec, pace_uphill_rating: epUphillRating, pace_downhill_rating: epDownhillRating,
    })
    .eq('id', epUserId);
  if (error) {
    if (error.code === '23505') {
      document.getElementById('ep-username-status').textContent = 'Ese usuario ya está en uso.';
      document.getElementById('ep-username-status').style.color = 'var(--up2)';
    } else {
      showToast('No se pudo guardar tu perfil: ' + error.message);
    }
    return;
  }
  location.href = '/' + username;
}

async function init(){
  const stateMsg = document.getElementById('state-msg');
  const { data: { session } } = await supabaseClient.auth.getSession();
  if (!session) {
    stateMsg.innerHTML = 'Necesitas iniciar sesión primero. <a href="/" style="color:var(--orange);font-weight:700">Ir al inicio</a>';
    return;
  }
  epUserId = session.user.id;

  const { data: profile, error } = await supabaseClient
    .from('profiles')
    .select('username, display_name, avatar_color, avatar_url, pace_flat_sec_per_km, pace_uphill_rating, pace_downhill_rating')
    .eq('id', epUserId)
    .maybeSingle();

  if (error || !profile) {
    stateMsg.innerHTML = 'No encontramos tu perfil. <a href="/" style="color:var(--orange);font-weight:700">Ir al inicio</a>';
    return;
  }

  document.getElementById('ep-name').value = profile.display_name || '';
  document.getElementById('ep-username').value = profile.username;
  document.getElementById('cancel-link').href = '/' + profile.username;
  epAvatarUrl = profile.avatar_url;
  setColor(profile.avatar_color);

  if (profile.pace_flat_sec_per_km) {
    document.getElementById('ep-pace-min').value = Math.floor(profile.pace_flat_sec_per_km / 60);
    document.getElementById('ep-pace-sec').value = String(profile.pace_flat_sec_per_km % 60).padStart(2, '0');
  }
  if (profile.pace_uphill_rating) setRating('uphill', profile.pace_uphill_rating);
  if (profile.pace_downhill_rating) setRating('downhill', profile.pace_downhill_rating);

  document.getElementById('ep-color-swatches').addEventListener('click', (e) => {
    const swatch = e.target.closest('.swatch');
    if (swatch) setColor(swatch.dataset.color);
  });
  document.getElementById('ep-photo-input').addEventListener('change', (e) => {
    handleAvatarPhotoSelect(e.target.files[0]);
  });
  document.getElementById('ep-uphill-pills').addEventListener('click', (e) => {
    const pill = e.target.closest('.rating-pill');
    if (pill) setRating('uphill', pill.dataset.value);
  });
  document.getElementById('ep-downhill-pills').addEventListener('click', (e) => {
    const pill = e.target.closest('.rating-pill');
    if (pill) setRating('downhill', pill.dataset.value);
  });
  document.getElementById('ep-username').addEventListener('input', () => {
    clearTimeout(epUsernameCheckTimer);
    epUsernameCheckTimer = setTimeout(checkUsernameAvailability, 400);
  });

  stateMsg.style.display = 'none';
  document.getElementById('form-content').style.display = 'block';
}

init();
</script>
</body>
</html>
